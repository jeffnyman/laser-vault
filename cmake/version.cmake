# Write the program's version, with the git commit it was built from, as C
# source. It runs on every build, so the commit is never out of date, but it
# only rewrites the file when the text changes, so nothing rebuilds for no
# reason.
#
# Run as a script: cmake -DVERSION=0.1.0 -DSOURCE_DIR=dir -DOUTPUT=version.c -P version.cmake
# Produces:
#     const char laser_vault_version[] = "0.1.0 (041cf10)";
# "-dirty" after the commit means there were changes that weren't committed.
# Without git (a source download, say), it's just "0.1.0".

set(text "${VERSION}")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} describe --always --dirty --abbrev=7 --exclude=*
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE commit
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE result)
    if(result EQUAL 0 AND commit)
        set(text "${VERSION} (${commit})")
    endif()
endif()

set(content "// Generated by cmake/version.cmake. Do not edit.\n#include \"version.h\"\n\nconst char laser_vault_version[] = \"${text}\";\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT content STREQUAL old)
    file(WRITE "${OUTPUT}" "${content}")
endif()
