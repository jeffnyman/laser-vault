root = true

# Default settings for all text files.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.json]
indent_size = 2

[*.sh]
indent_size = 2

# Makefiles require tabs.
[{Makefile,*.mk}]
indent_style = tab

# Markdown allows trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false
